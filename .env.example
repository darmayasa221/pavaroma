# Salin jadi .env.local untuk development, dan isikan juga di Vercel
# (Project → Settings → Environment Variables).
#
# Hanya variabel berawalan VITE_ yang ikut ter-bundle ke browser.
# JANGAN pernah menaruh service_role key di sini — key itu bisa membaca
# seluruh database Anda dan akan terlihat oleh siapa pun yang membuka situs.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# JANGAN pakai sb_secret_… di sini. Kunci itu menembus seluruh RLS dan akan
# ter-bundle ke browser. src/lib/supabase.ts sengaja melempar error di dev
# kalau mendeteksinya.

# ─────────────────────────────────────────────────────────────
# Berikut ini TIDAK dipakai frontend. Diisi di Supabase Dashboard →
# Edge Functions → Secrets, bukan di file ini.
# ─────────────────────────────────────────────────────────────
#
# NOTIFY_PROVIDER   = webhook | callmebot | whatsapp_cloud | telegram | console
#
# Cara menguji: hasil tiap percobaan tercatat di kolom orders.notify_status
# ('sent' atau pesan error), jadi tidak perlu mengubek-ubek log.
#   select ref, notify_status, notified_at from orders order by created_at desc;
#
# -- webhook (paling mudah diuji; buka webhook.site, salin URL-nya)
# WEBHOOK_URL       = https://webhook.site/xxxxxxxx-xxxx-xxxx
#
# -- callmebot (gratis, langsung masuk WhatsApp Anda, tanpa nomor baru)
# CALLMEBOT_PHONE   = 6282144703290
# CALLMEBOT_APIKEY  = 123456
#
# -- whatsapp_cloud (resmi Meta; butuh nomor terpisah + verifikasi bisnis)
# WA_PHONE_NUMBER_ID = 1234567890
# WA_ACCESS_TOKEN    = EAAG...
# WA_RECIPIENT       = 6282144703290
# WA_TEMPLATE_NAME   = order_baru        # kosongkan utk kirim teks biasa (hanya jalan dlm jendela 24 jam)
#
# -- telegram (gratis, paling cepat disiapkan)
# TELEGRAM_BOT_TOKEN = 123456:ABC...
# TELEGRAM_CHAT_ID   = 123456789
